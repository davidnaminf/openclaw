# Main pipeline config (sources + filters in one place)
PIPELINE_CONFIG_FILE=config/pipeline.json

# YouTube Data API key (required only when youtube_channel sources are enabled)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API key (optional; if missing weekly summary falls back to heuristic mode)
OPENAI_API_KEY=

# Optional override if yt-dlp is not in PATH
YT_DLP_PATH=yt-dlp
